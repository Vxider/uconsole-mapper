WHISPER_URL=http://127.0.0.1:3300/api/asr/transcriptions

# Optional whisper fields.
# WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=zh
# WHISPER_AUTH_TOKEN=
# Optional short ASR hint sent to the upstream transcription model.
# WHISPER_PROMPT=
# Multipart field name used for the ASR prompt.
# WHISPER_PROMPT_FIELD=prompt
# Multipart field name used for request-level glossary JSON.
# WHISPER_PROMPT_GLOSSARY_FIELD=promptGlossary
# User glossary file, one term per line.
# VOICE_GLOSSARY_FILE=~/.config/uconsole-mapper/voice-glossary.txt
# Multipart field name used for tmux context sent to correction.
# WHISPER_CONTEXT_FIELD=contextText
# Explicitly ask the ASR service to run correction.
WHISPER_ENABLE_CORRECTION=1
WHISPER_NO_PROXY=1

# Extract transcript text from the whisper response.
# WHISPER_TEXT_JQ=.text // .result.text // .data.text // empty

# Recorder selection: auto | pw-record | ffmpeg | arecord
VOICE_RECORDER=auto
VOICE_INPUT=default
VOICE_MIN_RECORD_MS=350
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1

# Text injection mode: type | type_enter | clipboard | paste
VOICE_OUTPUT_MODE=type

# Keep recorded wav files for debugging: 0 | 1
VOICE_KEEP_AUDIO=0

# Allow Esc to cancel the active recording before it is sent to ASR: 0 | 1
VOICE_ESC_CANCEL=1
# Python used for Esc monitoring. /usr/bin/python3 is checked by install.sh.
VOICE_PYTHON_BIN=/usr/bin/python3

# Notification appearance.
VOICE_NOTIFY_USE_MARKUP=0
VOICE_NOTIFY_FONT_SIZE=16
VOICE_NOTIFY_PADDING_LINES=1

# When the active input is a tmux terminal window, include the current tmux
# active pane visible text as ASR context.
VOICE_TMUX_CONTEXT=1
# If the visible area is too short, fall back to at least this many recent lines.
# VOICE_TMUX_CONTEXT_LINES=30
# VOICE_TMUX_CONTEXT_MAX_CHARS=1200
