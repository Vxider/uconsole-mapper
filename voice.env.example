WHISPER_URL=http://127.0.0.1:9000/v1/audio/transcriptions

# Optional whisper fields.
# WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=zh
# WHISPER_AUTH_TOKEN=
WHISPER_NO_PROXY=1

# Extract transcript text from the whisper response.
# WHISPER_TEXT_JQ=.text // .result.text // .data.text // empty

# Recorder selection: auto | pw-record | ffmpeg | arecord
VOICE_RECORDER=auto
VOICE_INPUT=default
VOICE_MIN_RECORD_MS=350
VOICE_SAMPLE_RATE=16000
VOICE_CHANNELS=1

# Text injection mode: type | type_enter | clipboard | paste
VOICE_OUTPUT_MODE=type

# Keep recorded wav files for debugging: 0 | 1
VOICE_KEEP_AUDIO=0
